# Vivado / Vitis build output
vivado_*/
vivado/
ip_repo_*/
pack_tmp_*/
out/
out_*/
common/ooc/
*.jou
*.log
*.str
*.stdout
*.backup.jou
*.backup.log
.Xil/

# DFX floorplan visualisation, written by the implementation runs
hd_visual/

# Generated by build_impl.tcl from ch13_pblock_region in common/config.tcl --
# create_pblock needs an open design, which project mode has none of at that
# point, so the pblock is emitted as a constraint file instead.
**/constraints/pblock.xdc

# xsim working directories (SystemVerilog/build)
build/

# Device-tree overlay build output -- dts/*.dtsi and the Makefile are the
# source; the .dtbo is compiled by `make` in that directory.
*.dtbo

# Python
__pycache__/
*.pyc
